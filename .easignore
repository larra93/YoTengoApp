# Copia de .gitignore: EAS CLI usa este archivo en vez de .gitignore,
# por lo que debe incluir todas sus reglas. La última línea vuelve a
# incluir google-services.json en el upload (no se commitea).

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*-firebase-adminsdk-*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# incluir en el upload de EAS pese a .gitignore
!google-services.json
