{
  "expo": {
    "name": "YoTengoApp",
    "slug": "yotengoapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yotengoapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "bundleIdentifier": "com.yotengoapp.app"
    },
    "android": {
      "package": "com.yotengoapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#CCFBF1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YoTengoApp usa tu ubicación para mostrarte pedidos cercanos de tus vecinos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "YoTengoApp usa tus fotos para agregar imágenes de referencia a tus pedidos y ofertas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfd9d838-27c7-4df0-ac4a-eb752600a619"
      }
    },
    "owner": "flarraguibel"
  }
}
